    "latam",
    "job-search",
    "ai",
    "automation"
  ],
  "author": "Fork argentino basado en career-ops de Santiago Fernández de Valderrama <hi@santifer.io> (https://santifer.io)",
  "homepage": "https://github.com/Diez111/career-ops-ar",
